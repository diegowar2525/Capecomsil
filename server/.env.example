PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Desarrollo: orígenes exactos del frontend y de la API (sin barra final).
AUTH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
AUTH_SESSION_HOURS=12
# Producción: NODE_ENV=production y AUTH_ORIGINS con HTTPS.

# Bucket privado de Cloudflare R2. Sin estas variables el resto de la API funciona.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Origen público que sirve /api; en desarrollo puede ser el proxy de Vite.
# En producción use el mismo origen HTTPS que el frontend mediante proxy /api.
API_PUBLIC_URL=http://localhost:5173
